# Flask
SECRET_KEY=replace-with-a-random-secret
PORT=5000
# Comma-separated list of frontend origins allowed to call the API (e.g. your Render URL)
WIDGET_ALLOWED_ORIGINS=*
# true when running behind Caddy/nginx (production)
TRUST_PROXY=false

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# PostgreSQL + pgvector (docker compose db service uses these defaults)
DATABASE_URL=postgresql://fintech:fintech@localhost:5432/fintech
DB_POOL_MAX=5
DB_TIMEOUT_SECONDS=10
# Where original uploaded knowledge-base files are kept
FILE_STORAGE_DIR=uploads/knowledge_base

# Retrieval and embeddings
ENABLE_VECTOR_RETRIEVAL=false
RETRIEVAL_MATCH_COUNT=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
QEHWA_MODEL_ID=junaid008/qehwa-pashto-llm
QEHWA_DEVICE=cpu
QEHWA_MAX_NEW_TOKENS=300
QEHWA_TEMPERATURE=0.3
